# Anthropic API key — required for receipt image OCR
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite:///./costco_prices.db

# CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://costco.localhost

# Caddy reverse proxy — registers http://costco.localhost (app ports are OS-assigned per launch)
# Admin API port is discovered automatically via ../infra/caddy_registry.py
CADDY_APP_NAME=costco
